# E-YUVA ERP Backend Configurations

# Database Settings
DATABASE_URL=your database_url_here

# Security
# Run: openssl rand -hex 32 to generate a strong secret key
JWT_SECRET_KEY=your_secret_key_here
JWT_ALGORITHM=your_algorithm_here
ACCESS_TOKEN_EXPIRE_MINUTES=your_access_token_expiration_time_in_minutes_here
REFRESH_TOKEN_EXPIRE_DAYS=your_refresh_token_expiration_time_in_days_here

# CORS Setup
# JSON-encoded array of allowed origins
CORS_ORIGINS=["http://localhost:3000", "http://localhost:5173", "http://127.0.0.1:5173"]
